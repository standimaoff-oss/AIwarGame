{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/standimaoff-oss/AIwarGame/references/templates/asset-manifest.schema.json",
  "title": "3D asset manifest",
  "description": "Machine-readable description of a delivered asset. Generated by scripts/make_manifest.py (Blender, read-only) and extended manually with task fields.",
  "type": "object",
  "required": ["schema_version", "identity", "units", "dimensions_mm", "budget"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "generated_by": {"type": "string", "description": "Script or tool that produced this file."},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_file": {"type": "string", "description": "Path to the editable .blend relative to the repository root."},
    "identity": {
      "type": "object",
      "required": ["slug", "name", "archetype", "status"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "archetype": {
          "type": "string",
          "enum": ["architecture", "character", "hard_surface", "prop", "vehicle", "environment", "texture_set", "scene", "other"]
        },
        "variant": {"type": "string"},
        "version": {"type": "string"},
        "status": {"type": "string", "enum": ["wip", "review", "done", "blocked"]},
        "task_issue": {"type": ["string", "integer"]},
        "branch": {"type": "string"}
      }
    },
    "units": {
      "type": "object",
      "required": ["unit", "scale_length", "up_axis"],
      "additionalProperties": false,
      "properties": {
        "unit": {"type": "string", "enum": ["m", "cm", "mm", "km", "in", "ft"]},
        "scale_length": {"type": "number", "exclusiveMinimum": 0},
        "up_axis": {"type": "string", "enum": ["Z", "Y"]},
        "export_up_axis": {"type": "string", "enum": ["Z", "Y"]},
        "unit_system": {"type": "string"}
      }
    },
    "dimensions_mm": {
      "type": "object",
      "required": ["bbox"],
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"},
          "description": "World-space bounding box X, Y, Z in millimetres."
        },
        "frame": {"type": "integer"},
        "includes": {"type": "string", "description": "What is included: accessories, pose, attachments."},
        "scope": {"type": "string", "description": "Collections or objects measured."}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triangles": {"type": "integer", "minimum": 0},
        "triangles_limit": {"type": "integer", "minimum": 0},
        "vertices": {"type": "integer", "minimum": 0},
        "objects": {"type": "integer", "minimum": 0},
        "material_sets": {"type": "integer", "minimum": 0},
        "texture_resolution": {"type": "string"},
        "lods": {"type": "integer", "minimum": 0},
        "udim_tiles": {"type": "integer", "minimum": 0}
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "objects": {"type": "integer", "minimum": 0},
          "triangles": {"type": "integer", "minimum": 0},
          "role": {"type": "string"},
          "movable": {"type": "boolean"},
          "pivot": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "children": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "slots": {"type": "integer", "minimum": 0},
          "procedural": {"type": "boolean"},
          "images": {"type": "array", "items": {"type": "string"}},
          "packed": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "map"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "map": {
            "type": "string",
            "enum": ["BaseColor", "Roughness", "Metallic", "Normal", "NormalDX", "Height", "AO", "Emissive", "Opacity", "Curvature", "Thickness", "Sheen", "Anisotropy", "ORM", "Other"]
          },
          "set": {"type": "string"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "colorspace": {"type": "string", "enum": ["sRGB", "Non-Color", "Raw", "Unknown"]},
          "packed": {"type": "boolean"},
          "tilable": {"type": "boolean"},
          "provenance": {"type": "string"}
        }
      }
    },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["none", "pivots", "armature", "drivers", "simulation"]},
        "armatures": {"type": "array", "items": {"type": "string"}},
        "bones": {"type": "integer", "minimum": 0},
        "controls": {"type": "array", "items": {"type": "string"}},
        "shape_keys": {"type": "array", "items": {"type": "string"}},
        "frame_start": {"type": "integer"},
        "frame_end": {"type": "integer"},
        "animation_kind": {"type": "string", "enum": ["none", "staged", "simulation"]},
        "notes": {"type": "string"}
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "format": {"type": "string", "enum": ["glb", "gltf", "fbx", "obj", "usd", "usdz", "stl", "ply", "abc", "other"]},
          "options": {"type": "object"},
          "validated_by": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "criterion": {"type": "string"},
          "kind": {"type": "string", "enum": ["silhouette", "clay", "macro", "passage", "interior", "material", "pose", "turntable", "checker_uv", "scale_ref", "compare_ref", "wireframe", "hero", "other"]},
          "camera": {"type": "string"},
          "engine": {"type": "string"}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {"type": "string"},
        "report": {"type": "string"},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "INFO", "ERROR", "not_run"]},
        "checks_total": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string"},
          "url": {"type": "string"},
          "license": {"type": "string"},
          "used_for": {"type": "string"}
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
